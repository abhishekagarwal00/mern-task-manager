PORT=5000
NODE_ENV=development
# Local:  mongodb://127.0.0.1:27017/taskflow
# Cloud:  your MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/taskflow
# Use a long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Only needed when frontend is hosted on a different origin (dev uses Vite proxy)
CLIENT_ORIGIN=http://localhost:5173
